// Lavifort CRM — schema canônico (derivado das telas do front em larvifort-crm/src)
// Regra: Prisma = ORM de runtime. Knex = migrations/seeds (DDL fora do Prisma Migrate).
// Não permitir acesso direto ao Prisma fora de *.prisma.repository.ts (ver SPECS.md).

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------- Enums ----------
enum Role {
  ADMIN
  USER
}

enum StatusLead {
  NOVO
  SEM_CONTATO
  EM_NEGOCIACAO
  CLIENTE_ATIVO
}

enum StatusEmpresa {
  ATIVA
  PROSPECT
  INATIVA
}

enum TipoCompromisso {
  REUNIAO
  VISITA
}

enum StatusTarefa {
  BACKLOG
  EM_ANDAMENTO
  EM_REVISAO
  CONCLUIDO
}

enum TipoTask {
  GERAL
  COMPROMISSO
  PEDIDO
  ORCAMENTO
}

enum OrderStatus {
  ORCAMENTO
  PEDIDO
}

enum OrderPhase {
  DRAFT
  ABERTO
  PENDING
  APROVADO
  FATURADO
  ENTREGUE
  CANCELLED
}

enum OrderItemType {
  PRODUCT
  SERVICE
}

// Flujo operacional del pedido (API-018): rascunho → … → fechado/cancelado.
enum OrderOperationalStatus {
  RASCUNHO
  AGUARDANDO_ESTOQUE
  ESTOQUE_RESERVADO
  AGUARDANDO_CONFIRMACION
  CONFIRMADO
  FECHADO
  CANCELADO
  AGUARDANDO_SEPARACAO
  AGUARDANDO_MOTORISTA
}

// Status de una OS (orden de servicio) de laboratório (API-021).
enum LabWorkOrderStatus {
  AGUARDANDO_LABORATORIO
  RECEBIDO
  EM_PREPARACAO
  PRONTO_PARA_SEPARACAO
  BLOQUEADO
  CANCELADO
}

enum SeparationStatus {
  AGUARDANDO_SEPARACAO
  EM_SEPARACAO
  SEPARADO
  DIVERGENCIA
}

enum FiscalStatus {
  NAO_SOLICITADO
  PENDENTE_DADOS
  PRONTO_EMISSAO
  NF_EMITIDA
  NF_CANCELADA
}

enum Prioridade {
  ALTA
  MEDIA
  BAIXA
}

enum Uniformidade {
  OTIMA
  BOA
  REGULAR
  RUIM
}

// ---------- Auth / Equipe / Perfil (telas: Login, Equipe, Perfil) ----------
model Team {
  id        String   @id @default(uuid())
  name      String   @unique
  members   User[]
  projects  Projeto[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model User {
  id           String    @id @default(uuid())
  firstName    String
  lastName     String
  email        String    @unique
  passwordHash String
  role         Role      @default(USER)
  active       Boolean   @default(true)
  teamId       String?
  team         Team?     @relation(fields: [teamId], references: [id], onDelete: SetNull)
  // relações de trabalho
  assignedTasks Task[]        @relation("TaskAssignee")
  responsibleProjects Projeto[] @relation("ProjectResponsible")
  appointments  Appointment[] @relation("AppointmentOwner")
  searches      FieldSearch[] @relation("SearchOwner")
  sales         Sale[]
  metas         Meta[]
  salesOrders   Order[]       @relation("OrderSalesRep")
  createdOrders Order[]       @relation("OrderCreator")
  refreshTokens RefreshToken[]
  confirmedActivities TaskActivityConfirmation[]
  postSales     PostSale[]
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model RefreshToken {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String   @unique
  expiresAt DateTime
  revoked   Boolean  @default(false)
  createdAt DateTime @default(now())
}

// ---------- Empresas / Grupos (tela: Empresas) ----------
model GrupoComercial {
  id        String    @id @default(uuid())
  name      String    @unique
  color     String    @default("#0ea5e9")
  empresas  Empresa[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

model Empresa {
  id           String          @id @default(uuid())
  name         String
  cnpj         String?         @unique
  city         String?
  status       StatusEmpresa   @default(PROSPECT)
  grupoId      String?
  grupo        GrupoComercial? @relation(fields: [grupoId], references: [id], onDelete: SetNull)
  clientes     Cliente[]
  appointments Appointment[]
  orders       Order[]
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([grupoId])
  @@index([status])
}

// ---------- Clientes / Contatos (tela: Clientes + NovoContatoModal) ----------
model Cliente {
  id          String     @id @default(uuid())
  firstName   String
  lastName    String
  email       String?
  phone       String?
  birthdate   DateTime?
  cpfCnpj     String?    @unique
  statusLead  StatusLead @default(NOVO)
  origem      String? // Site | Institucional | Indicação | Feira | Prospecção
  pais        String?    @default("Brasil")
  cidade      String?
  uf          String?
  endereco    String?
  observacoes String?
  empresaId   String?
  empresa     Empresa?   @relation(fields: [empresaId], references: [id], onDelete: SetNull)
  // Piscicultura / camarão (modal Novo Contato — seção dedicada)
  laminaAgua            Float? // m²
  qtdViveiros           Int?
  densidade             Float? // ind/m²
  producaoMedia         Float? // kg/ciclo
  temBercario           Boolean @default(false)
  qtdBercarios          Int?
  volumeBercarios       Float? // m³
  alimentadorAutomatico Boolean @default(false)
  // relações
  appointments Appointment[]
  searches     FieldSearch[]
  sales        Sale[]
  tasks        Task[]
  orders       Order[]
  postSales    PostSale[]
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([statusLead])
  @@index([cidade])
  @@index([empresaId])
}

// ---------- Agenda (tela: Agenda + NovoCompromissoModal) ----------
model Appointment {
  id         String           @id @default(uuid())
  tipo       TipoCompromisso
  titulo     String
  data       DateTime // dia do compromisso
  horario    String? // HH:mm
  endereco   String?
  observacoes String?
  clienteId  String?
  cliente    Cliente? @relation(fields: [clienteId], references: [id], onDelete: SetNull)
  empresaId  String?
  empresa    Empresa? @relation(fields: [empresaId], references: [id], onDelete: SetNull)
  ownerId    String?
  owner      User?    @relation("AppointmentOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  tasks      Task[]
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([data])
  @@index([tipo])
  @@index([clienteId])
  @@index([empresaId])
}

// ---------- Kanban (telas: Kanban + parte do Dashboard workload) ----------
model Projeto {
  id        String          @id @default(uuid())
  name      String          @unique // ex: LarviFort CRM, App Delivery, Portal Fornecedor
  taskPrefix String         @default("TK")
  taskSequence Int          @default(-1)
  teamId    String?
  team      Team?           @relation(fields: [teamId], references: [id], onDelete: SetNull)
  responsibleId String?
  responsible User?         @relation("ProjectResponsible", fields: [responsibleId], references: [id], onDelete: SetNull)
  columns     ProjetoColumn[]
  tasks       Task[]
  orders      Order[]
  automations ProjetoAutomacao[]
  outboxEvents AutomationOutboxEvent[]
  createdAt   DateTime        @default(now())
  updatedAt DateTime        @updatedAt

  @@index([teamId])
  @@index([responsibleId])
}

model ProjetoColumn {
  id        String   @id @default(uuid())
  projetoId String
  projeto   Projeto  @relation(fields: [projetoId], references: [id], onDelete: Cascade)
  title     String
  order     Int      @default(0)
  color     String?
  tasks     Task[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([projetoId, order])
}

model Task {
  id          String         @id @default(uuid())
  projetoId   String
  projeto     Projeto        @relation(fields: [projetoId], references: [id], onDelete: Cascade)
  columnId    String?
  column      ProjetoColumn? @relation(fields: [columnId], references: [id], onDelete: SetNull)
  titulo      String
  referenceNumber Int?
  referenceCode String?
  descricao   String?
  status      StatusTarefa   @default(BACKLOG)
  tipo        TipoTask       @default(GERAL)
  appointmentId String?      @unique
  appointment   Appointment? @relation(fields: [appointmentId], references: [id], onDelete: SetNull)
  clienteId   String?
  cliente     Cliente?       @relation(fields: [clienteId], references: [id], onDelete: SetNull)
  confirmation TaskActivityConfirmation?
  prioridade  Prioridade     @default(MEDIA)
  progresso   Int            @default(0) // 0-100
  tags        String[]       @default([])
  prazo       DateTime?
  estimativaH Float?
  assigneeId  String?
  assignee    User?          @relation("TaskAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  parentId    String?
  parent      Task?          @relation("TaskSubtasks", fields: [parentId], references: [id], onDelete: Cascade)
  subtasks    Task[]         @relation("TaskSubtasks")
  attachments TaskAttachment[]
  orderId     String?
  orderNumber String?
  orderTotal  Float?
  orderTasks  OrderTask[]
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  @@index([projetoId, status])
  @@index([columnId])
  @@index([assigneeId])
  @@index([appointmentId])
  @@index([clienteId])
  @@index([tipo])
  @@index([parentId])
  @@index([projetoId, referenceNumber])
}

model TaskActivityConfirmation {
  id             String   @id @default(uuid())
  taskId         String   @unique
  task           Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  confirmedById  String
  confirmedBy    User     @relation(fields: [confirmedById], references: [id], onDelete: Cascade)
  confirmedAt    DateTime @default(now())
  latitude       Float
  longitude      Float
  accuracyMeters Float
  createdAt      DateTime @default(now())

  @@index([taskId])
  @@index([confirmedById])
}

model TaskAttachment {
  id        String   @id @default(uuid())
  taskId    String
  task      Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  filename  String
  path      String   // Path in storage (e.g. S3 key or local path)
  mimeType  String
  size      Int
  createdAt DateTime @default(now())

  @@index([taskId])
}


// ---------- Pesquisa de campo (tela: Pesquisa + NovaPesquisaModal + detalhe) ----------
model FieldSearch {
  id                  String         @id @default(uuid())
  clienteId           String
  cliente             Cliente        @relation(fields: [clienteId], references: [id], onDelete: Cascade)
  dataPesquisa        DateTime       @default(now())
  responsavelId       String?
  responsavel         User?          @relation("SearchOwner", fields: [responsavelId], references: [id], onDelete: SetNull)
  larvas              String[]       @default([]) // ex: ["Larvifort","Larva A"]
  maioriaLarvifort    Boolean        @default(false)
  parouLarvifort      Boolean        @default(false)
  motivosSaida        String[]       @default([])
  outroMotivo         String?
  uniformidadeBercario Uniformidade?
  uniformidadeCultivo  Uniformidade?
  sobrevBercario      Float? // 0-100
  sobrevCultivo       Float? // 0-100
  resultadosUltimoCiclo String?
  observacoes         String?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  @@index([clienteId])
  @@index([dataPesquisa])
}

// ---------- Vendas / Metas (tela: Dashboard — Taxa de Vendas, Metas, Frequência) ----------
model Sale {
  id         String   @id @default(uuid())
  vendedorId String
  vendedor   User     @relation(fields: [vendedorId], references: [id], onDelete: Cascade)
  clienteId  String?
  cliente    Cliente? @relation(fields: [clienteId], references: [id], onDelete: SetNull)
  valor      Float
  data       DateTime @default(now())
  createdAt  DateTime @default(now())

  @@index([vendedorId, data])
}

model Meta {
  id          String   @id @default(uuid())
  vendedorId  String
  vendedor    User     @relation(fields: [vendedorId], references: [id], onDelete: Cascade)
  mes         String // YYYY-MM
  metaValor   Float
  metaVolume  Int
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([vendedorId, mes])
}

// ---------- Regras Personalizadas (FASE 5 - API-008) ----------
enum RuleScope {
  USER
  TEAM
  ROLE
  COLUMN
}

enum RuleAction {
  ALLOW_MOVE
  DENY_MOVE
  REQUIRE_FIELD
  SET_FIELD
  TRIGGER_AUTOMATION
}

model Rule {
  id          String      @id @default(uuid())
  name        String
  description String?
  scope       RuleScope
  scopeId     String?     // userId, teamId, role, or columnId depending on scope
  projectId   String?     // optional project scoping
  columnId    String?     // specific column this rule applies to (for COLUMN scope)
  action      RuleAction
  conditions  Json        // JSON conditions for when rule applies
  parameters  Json        // JSON parameters for the action
  priority    Int         @default(0) // higher priority wins
  active      Boolean     @default(true)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  @@index([scope, scopeId])
  @@index([projectId])
  @@index([columnId])
  @@index([active])
}

// ---------- Automações de Projeto (FASE 5 - API-009) ----------
enum AutomationTrigger {
  TASK_CREATED
  TASK_UPDATED
  TASK_MOVED
  TASK_ASSIGNED
  TASK_DUE_SOON
  TASK_OVERDUE
  APPOINTMENT_CREATED
  ORDER_CREATED
  ORDER_UPDATED
  ORDER_CLOSED
}

enum AutomationConditionMode {
  AND
  OR
}

enum AutomationExecutionResult {
  RUNNING
  SUCCESS
  SKIPPED
  FAILED
}

enum AutomationOutboxStatus {
  PENDING
  PROCESSED
  DEAD
}

model ProjetoAutomacao {
  id            String                      @id @default(uuid())
  projetoId     String
  projeto       Projeto                     @relation(fields: [projetoId], references: [id], onDelete: Cascade)
  name          String
  description   String?
  trigger       AutomationTrigger
  conditions    Json
  conditionMode AutomationConditionMode     @default(AND)
  actions       Json
  schedule      String?
  isActive      Boolean                     @default(true)
  priority      Int                         @default(0)
  createdBy     String
  executions    AutomationExecution[]
  createdAt     DateTime                    @default(now())
  updatedAt     DateTime                    @updatedAt
  deletedAt     DateTime?

  @@index([projetoId, trigger, isActive, priority])
  @@index([deletedAt])
}

model AutomationExecution {
  id           String                    @id @default(uuid())
  automationId String
  automation   ProjetoAutomacao          @relation(fields: [automationId], references: [id], onDelete: Cascade)
  eventId      String
  attempt      Int
  durationMs   Int?
  result       AutomationExecutionResult @default(RUNNING)
  error        String?
  createdAt    DateTime                  @default(now())
  completedAt  DateTime?

  @@unique([automationId, eventId, attempt])
  @@index([eventId])
}

model AutomationOutboxEvent {
  id             String                 @id @default(uuid())
  eventId        String                 @unique
  eventType      AutomationTrigger
  projetoId      String
  projeto        Projeto                @relation(fields: [projetoId], references: [id], onDelete: Cascade)
  aggregateId    String
  payload        Json
  depth          Int                    @default(0)
  causationChain Json                   @default("[]")
  status         AutomationOutboxStatus @default(PENDING)
  attempts       Int                    @default(0)
  availableAt    DateTime               @default(now())
  processedAt    DateTime?
  lastError      String?
  createdAt      DateTime               @default(now())
  updatedAt      DateTime               @updatedAt

  @@index([status, availableAt])
  @@index([projetoId])
}

// ---------- Produtos (FASE 7 - API-015) ----------
model Product {
  id          String   @id @default(uuid())
  code        String   @unique
  name        String
  unit        String   @default("UN") // ex: MILHEIRO, KG, UN
  price       Float?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// ---------- Pedidos / Orçamentos (Módulo Orders — padrão UPSprint) ----------
model Order {
  id                   String      @id @default(uuid())
  orderNumber          String?     @unique
  status               OrderStatus @default(PEDIDO)
  phase                OrderPhase  @default(ABERTO)
  operationalStatus    OrderOperationalStatus @default(RASCUNHO)
  fiscalStatus         FiscalStatus           @default(NAO_SOLICITADO)
  fiscalData           Json?                  @default("{}")
  fiscalNotes          String?
  clientId             String
  client               Cliente     @relation(fields: [clientId], references: [id], onDelete: Cascade)
  companyId            String?
  company              Empresa?    @relation(fields: [companyId], references: [id], onDelete: SetNull)
  projectId            String?
  project              Projeto?    @relation(fields: [projectId], references: [id], onDelete: SetNull)
  salesRepUserId       String?
  salesRepUser         User?       @relation("OrderSalesRep", fields: [salesRepUserId], references: [id], onDelete: SetNull)
  creatorId            String?
  creator              User?       @relation("OrderCreator", fields: [creatorId], references: [id], onDelete: SetNull)

  subtotal             Float       @default(0)
  discount             Float       @default(0)
  shippingCost         Float       @default(0)
  taxAmount            Float       @default(0)
  totalAmount          Float       @default(0)

  paymentMethod        String?
  paymentCondition     String?
  paymentDate          DateTime?
  shippingMethod       String?
  trackingCode         String?
  deliveryInstructions String?
  deliveryShift        String?
  shippingAddress      Json?       @default("{}")
  billingAddress       Json?       @default("{}")
  notes                String?
  cancellationReason   String?
  cancelledAt          DateTime?
  closedAt             DateTime?
  closedBy             String?
  customerConfirmedBy  String?
  customerConfirmedAt  DateTime?
  customerConfirmationNote String?
  customerEvents       OrderCustomerEvent[]
  postSale             PostSale?

  orderDate            DateTime    @default(now())
  shippingDate         DateTime?
  deliveryDate         DateTime?

  items                OrderItem[]
  tasks                OrderTask[]
  labWorkOrders        LabWorkOrder[]
  separazioni     OrderSeparation?
  delivery        Delivery?


  createdAt            DateTime    @default(now())
  updatedAt            DateTime    @updatedAt
  deletedAt            DateTime?

  @@index([clientId])
  @@index([companyId])
  @@index([projectId])
  @@index([salesRepUserId])
  @@index([status])
  @@index([phase])
  @@index([orderNumber])
  @@index([orderDate])
  @@index([deletedAt])
}

model OrderItem {
  id          String        @id @default(uuid())
  orderId     String
  order       Order         @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId   String?
  productCode String?
  productName String
  unit        String        @default("MILHEIRO")
  quantity    Float
  unitPrice   Float
  discount    Float         @default(0)
  totalPrice  Float
  notes       String?
  type        OrderItemType @default(PRODUCT)

  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  deletedAt   DateTime?

  @@index([orderId])
  @@index([productId])
  @@index([deletedAt])
}

model OrderTask {
  id               String   @id @default(uuid())
  orderId          String
  order            Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  taskId           String
  task             Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  relationshipType String   @default("PRODUCT")
  autoCreated      Boolean  @default(false)
  notes            String?
  createdAt        DateTime @default(now())

  @@unique([orderId, taskId])
  @@index([orderId])
  @@index([taskId])
}

model MetricGoal {
 id String @id @default(uuid())
 name String
 teamId String
 userIds String[]
 type String
 period String
 target Float
 startDate String
 endDate String
 createdBy String
 createdAt DateTime @default(now())
 updatedAt DateTime @updatedAt
 @@index([teamId])
}

// ---------- Stock (FASE 8 - API-016): unidades produtivas y locais/berçários ----------
enum StatusStock {
  ACTIVA
  INACTIVA
}

enum TipoUbicacion {
  BERCARIO
  ALMACEN
  OTRO
}

model StockUnit {
  id        String          @id @default(uuid())
  name      String          @unique
  city      String?
  status    StatusStock     @default(ACTIVA)
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt

  locations StockLocation[]
}

model StockLocation {
  id        String        @id @default(uuid())
  name      String
  unitId    String
  unit      StockUnit     @relation(fields: [unitId], references: [id], onDelete: Cascade)
  type      TipoUbicacion @default(BERCARIO)
  capacity  Float?
  status    StatusStock   @default(ACTIVA)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  @@unique([unitId, name])
  @@index([unitId])
  @@index([type])
}

// ---------- Stock Inventario (FASE 8 - API-017) ----------
enum StockMovementType {
  ENTRADA
  SALIDA
  BLOQUEO
  AJUSTE
}

enum StockReservationStatus {
  ACTIVA
  CANCELADA
  CONSUMIDA
}

// Saldo físico neto y reservado por (producto, local). Disponible = quantity - reserved.
model StockLevel {
  productId       String
  stockLocationId String
  quantity        Float   @default(0) // saldo físico neto (entradas - salidas - bloqueos - ajustes)
  reserved        Float   @default(0) // cantidad reservada (pedidos)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@id([productId, stockLocationId])
}

// Movimiento de stock con auditoría de responsable/fecha/motivo y vínculo opcional de pedido.
model StockMovement {
  id              String            @id @default(uuid())
  productId       String
  stockLocationId String
  type            StockMovementType
  quantity        Float
  reason          String?
  responsibleId   String?
  orderId         String?
  createdAt       DateTime          @default(now())

  @@index([productId])
  @@index([stockLocationId])
  @@index([orderId])
}

// Reserva de stock vinculada opcionalmente a un pedido; su cancelación devuelve la disponibilidad.
model StockReservation {
  id              String                @id @default(uuid())
  productId       String
  stockLocationId String
  orderId         String?
  quantity        Float
  status          StockReservationStatus @default(ACTIVA)
  responsibleId   String?
  createdAt       DateTime              @default(now())
  cancelledAt     DateTime?

  @@index([productId])
  @@index([stockLocationId])
  @@index([orderId])
}

// ---------- Logística (FASE 9 - API-023): Motoristas y veículos ----------
model Driver {
  id        String   @id @default(uuid())
  name      String
  phone     String?
  document  String?
  status    String   @default("DISPONIVEL") // DISPONIVEL, EM_ROTA, INDISPONIVEL
  region    String?
  deliveries Delivery[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Vehicle {
  id        String   @id @default(uuid())
  plate     String   @unique
  status    String   @default("DISPONIVEL") // DISPONIVEL, EM_ROTA, INDISPONIVEL
  deliveries Delivery[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Delivery {
  id              String   @id @default(uuid())
  orderId         String   @unique
  order           Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  driverId        String?
  driver          Driver?  @relation(fields: [driverId], references: [id], onDelete: SetNull)
  vehicleId       String?
  vehicle         Vehicle? @relation(fields: [vehicleId], references: [id], onDelete: SetNull)
  status          String   @default("AGUARDANDO_MOTORISTA")
  predictedAt     DateTime?
  completedAt     DateTime?
  proofUrl        String?
  notes           String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  postSale        PostSale?
}

enum PostSaleStatus {
  AGUARDANDO_CONTATO
  CONTATO_FEITO
  LARVA_OK
  CLIENTE_COM_PROBLEMA
  REVISITA_NECESSARIA
  FINALIZADO
}

model PostSale {
  id            String         @id @default(uuid())
  orderId       String         @unique
  order         Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  deliveryId    String         @unique
  delivery      Delivery       @relation(fields: [deliveryId], references: [id], onDelete: Cascade)
  clientId      String
  client        Cliente        @relation(fields: [clientId], references: [id], onDelete: Cascade)
  status        PostSaleStatus @default(AGUARDANDO_CONTATO)
  notes         String?
  nextAction    String?
  responsibleId String?
  responsible   User?          @relation(fields: [responsibleId], references: [id], onDelete: SetNull)
  contactedAt   DateTime?
  completedAt   DateTime?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  @@index([status])
  @@index([clientId])
}

// ---------- Confirmação do cliente / Histórico del pedido (FASE 8 - API-020) ----------
enum OrderCustomerEventType {
  CONFIRMACION
  SOLICITUD_CAMBIO
}

// ---------- Laboratório (FASE 9 - API-021): OS operacional por pedido fechado ----------
model LabWorkOrder {
  id                String              @id @default(uuid())
  orderId           String
  order             Order               @relation(fields: [orderId], references: [id], onDelete: Cascade)
  orderNumber       String?
  clientName        String?
  productId         String?
  productName       String
  quantity          Float
  unit              String              @default("MILHEIRO")
  stockUnitId       String?
  stockUnitName     String?
  stockLocationId   String?
  stockLocationName String?
  deliveryDate      DateTime?
  status            LabWorkOrderStatus  @default(AGUARDANDO_LABORATORIO)
  statusChangedBy   String?
  statusChangedAt   DateTime?
  createdById       String?
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt

  @@index([orderId])
  @@index([status])
}

// ---------- Separação y conferência (FASE 9 - API-022) ----------
model OrderSeparation {
  id              String           @id @default(uuid())
  orderId         String           @unique
  order           Order            @relation(fields: [orderId], references: [id], onDelete: Cascade)
  status          SeparationStatus @default(AGUARDANDO_SEPARACAO)
  startedAt       DateTime?
  startedBy       String?
  completedAt     DateTime?
  completedBy     String?
  divergenceNote  String?
  divergenceAt    DateTime?
  divergenceBy    String?
  updatedAt       DateTime         @updatedAt
  createdAt       DateTime         @default(now())
}

// Historia auditable de confirmaciones y solicitudes de cambio del cliente.
model OrderCustomerEvent {
  id         String                 @id @default(uuid())
  orderId    String
  order      Order                  @relation(fields: [orderId], references: [id], onDelete: Cascade)
  type       OrderCustomerEventType
  note       String?
  createdById String?
  createdAt  DateTime               @default(now())

  @@index([orderId])
}
